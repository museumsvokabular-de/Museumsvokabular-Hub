{
  "id": "https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Pendule",
  "type": "Concept",
  "prefLabel": {
    "de": "Pendule"
  },
  "definition": {
    "de": "Typisch elegante Form der französischen Stutzuhr der zweiten Hälfte des 17._Jahrhunderts bis Anfang des 19._Jahrhunderts. Sie unterlag den einzelnen Stilrichtungen und erreichte im 18._Jahrhundert ihre Vollendung."
  },
