{"componentChunkName":"component---src-components-concept-jsx","path":"/museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Wulstförmige_Dosenuhr.html","result":{"pageContext":{"node":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Wulstförmige_Dosenuhr","type":"Concept","prefLabel":{"de":"Wulstförmige Dosenuhr"},"altLabel":{"de":["Dosenuhr (Wulstförmige)","Uhr (Wulstförmige Dosen-)"]},"hiddenLabel":null,"definition":{"de":"Dieser Uhrentypus umfaßt den Zeitraum von ca. 1580 bis um 1660. Die Gehäuse dieser Dosenuhren waren wegen der abgerundeten Kanten angenehmer am Körper zu tragen als die scharfkantigen zylindrischen Dosen.+Die Gehäusegestalltung unterliegt folgendem Wandel:+1) Zuerst wird reiche Durchbrucharbeit der Metallgehäuse bevorzugt.+2) Später geht man zu geschlossenen Gehäusen über, die dann meist graviert wurden.+Aus den wulstförmigen Dosenuhren entwickeln sich in der zweiten Hälfte des 17._Jahrhunderts die eigentlichen Taschenuhren."},"note":null,"changeNote":null,"editorialNote":{"de":null},"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[],"narrowerTransitive":[],"broader":null,"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/gefaess/Dosenuhr"}],"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"inSchemeAll":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik"}],"topConceptOf":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":""}},"staticQueryHashes":["3649515864","4240049689","63159454"],"slicesMap":{}}