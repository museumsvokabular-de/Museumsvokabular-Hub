{"componentChunkName":"component---src-components-concept-jsx","path":"/museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Spindelhemmung.html","result":{"pageContext":{"node":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Spindelhemmung","type":"Concept","prefLabel":{"de":"Spindelhemmung"},"altLabel":{"de":["Hemmung (Spindel-)"]},"hiddenLabel":null,"definition":{"de":"Diese Hemmung erhielt ihren Namen von der sog. Spindel_- eine Achse mit zwei darauf befestigten Spindellappen_- die wechselseitig mit ihren Lappen in das Kron- oder Steigrad eingreift. Die Spindel ist fest mit dem Schwingsystem verbunden, so daß dieses nicht frei schwingen kann.+Diese Hemmungsart ist bei Großuhren ab dem 13._Jahrhundert und bei Kleinuhren ab der Mitte des 15._Jahrhunderts nachweisbar. Bei Taschenuhren wurde diese Hemmung bis ins späte 19._Jahrhundert verwendet."},"note":null,"changeNote":null,"editorialNote":{"de":null},"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[],"narrowerTransitive":[],"broader":null,"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/gefaess/Rückführende_Hemmung"}],"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"inSchemeAll":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik"}],"topConceptOf":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":""}},"staticQueryHashes":["3649515864","4240049689","63159454"],"slicesMap":{}}