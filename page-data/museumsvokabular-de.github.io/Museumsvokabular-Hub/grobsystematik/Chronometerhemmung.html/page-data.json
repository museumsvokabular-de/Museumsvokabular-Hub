{"componentChunkName":"component---src-components-concept-jsx","path":"/museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Chronometerhemmung.html","result":{"pageContext":{"node":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Chronometerhemmung","type":"Concept","prefLabel":{"de":"Chronometerhemmung"},"altLabel":{"de":["Hemmung (Chronometer-)"]},"hiddenLabel":null,"definition":{"de":"Die erste Chronometerhemmung wurde von Pierre Le Roy 1748 erfunden. 1766 wurde erstmals eine mit Chronometer-hemmung ausgerüstete Uhr einer Seeprüfung unterzogen. Die auf die Chronometerentwicklung entscheidenden Einfluß ausübenden Meister waren John Arnold und Thomas Earnshaw in England.+Die Chronometerhemmung findet sich in der Regel in Schiffs- und Taschenchronometern. Man unterscheidet zwei grundsätzliche Bauarten:+1) Chronometerhemmung mit Wippe+2) Chronometerhemmung mit Feder."},"note":null,"changeNote":null,"editorialNote":{"de":null},"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[],"narrowerTransitive":[],"broader":null,"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/gefaess/Freie_Hemmungen"}],"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"inSchemeAll":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik"}],"topConceptOf":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":""}},"staticQueryHashes":["3649515864","4240049689","63159454"],"slicesMap":{}}