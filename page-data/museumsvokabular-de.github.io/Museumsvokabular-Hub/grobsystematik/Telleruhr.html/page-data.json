{"componentChunkName":"component---src-components-concept-jsx","path":"/museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Telleruhr.html","result":{"pageContext":{"node":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Telleruhr","type":"Concept","prefLabel":{"de":"Telleruhr"},"altLabel":{"de":["Uhr (Teller-)"]},"hiddenLabel":null,"definition":{"de":"Eine spezifisch deutsche, wohl in Augsburg oder Nürnberg am Ende des 16. Jahrhunderts entstandene Form der Wanduhr. Das Zifferblatt ist wie ein Prunkteller mit breitem Rand versehen, der einen Ring trägt, welcher zum Aufhängen der Uhr an einem Wandarm dient. Telleruhren sind fast immer Federzuguhren. Zuerst haben die Telleruhren eine innen liegende Unrast, später fast immer ein kurzes Pendel vor dem Blatt."},"note":null,"changeNote":null,"editorialNote":{"de":null},"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[],"narrowerTransitive":[],"broader":null,"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/gefaess/Wanduhr"}],"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"inSchemeAll":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik"}],"topConceptOf":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":""}},"staticQueryHashes":["3649515864","4240049689","63159454"],"slicesMap":{}}