{"componentChunkName":"component---src-components-concept-jsx","path":"/spitzen/00000244.html","result":{"pageContext":{"node":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/spitzen/00000244","type":"Concept","prefLabel":{"de":"Lille-Spitze"},"altLabel":null,"hiddenLabel":null,"definition":{"de":"Spitze der Stadt Lille. Klöppelspitze im niederländischen Charakter, die auf die Trollkante zurückgeht. Seit 1700 mit Brüsseler Netz- und Mignontüll. Das alle Formen einfassende Schnürchen ist eingeklppelt. Charakteristisch ist das \"Lille-Auge\" und kleine eingestreute Stäbchen (point d' esprit).LIT.: Prof. Hempel, Albert: Das Spitzenbüchlein, Berlin 1934, S. 30;LIT.: Prof. Hempel, Albert: Spitzenformen Monographische Darstellung, Plauen 1926, Manuskript"},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":null,"notation":null,"example":{"de":"Point de Lille"},"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/spitzen/00000232","prefLabel":{"de":"Klöppelspitze"}},"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/spitzen","title":null}],"inSchemeAll":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/spitzen"}],"topConceptOf":[],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/"}},"staticQueryHashes":["3649515864","4240049689","63159454"],"slicesMap":{}}