{"componentChunkName":"component---src-components-concept-jsx","path":"/spitzen/00000275.html","result":{"pageContext":{"node":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/spitzen/00000275","type":"Concept","prefLabel":{"de":"Gaze, Point de"},"altLabel":null,"hiddenLabel":null,"definition":{"de":"Feinste Form der Brüsseler Nadelspitze. Seit Anfang des 19. Jahrhunderts hergestellt, ab 1862 auch mit erhabenen Formen. Die Ornament- und Pflanzenformen sind mit Ziernetzen gefüllt. Es ist eine feine verspielte Spitze mit Rosen, Sträußchen und Zweigen als beliebteste Motive. Ein typisches Merkmal ist, dass die Spitze keine Pikots aufweist.LIT.: Prof. Hempel, Albert: Das Spitzenbüchlein, Berlin 1934, S. 27"},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/spitzen/00000266","prefLabel":{"de":"Nadelspitze"}},"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/spitzen","title":null}],"inSchemeAll":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/spitzen"}],"topConceptOf":[],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/"}},"staticQueryHashes":["3649515864","4240049689","63159454"],"slicesMap":{}}