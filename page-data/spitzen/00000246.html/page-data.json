{"componentChunkName":"component---src-components-concept-jsx","path":"/spitzen/00000246.html","result":{"pageContext":{"node":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/spitzen/00000246","type":"Concept","prefLabel":{"de":"Malteser Spitze"},"altLabel":null,"hiddenLabel":null,"definition":{"de":"Formenschlagspitze, hauptsächlich in Seide gearbeitet. Häufiges Motiv ist das Malteser Kreuz, dazu kommen kleine dicke ovale Formenschlagmuster, Abart der Cluny-Spitze. Durch die Weltausstellung 1851 wurde die Spitze sehr populär und auch in weißer Baumwolle als \"Bedfordshire Maltese\" in England imitiert.LIT.: Prof. Hempel, Albert: Das Spitzenbüchlein, Berlin 1934, S. 31"},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/spitzen/00000232","prefLabel":{"de":"Klöppelspitze"}},"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/spitzen","title":null}],"inSchemeAll":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/spitzen"}],"topConceptOf":[],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/"}},"staticQueryHashes":["3649515864","4240049689","63159454"],"slicesMap":{}}