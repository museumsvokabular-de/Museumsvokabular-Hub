{"componentChunkName":"component---src-components-concept-jsx","path":"/grobsystematik/Monat.html","result":{"pageContext":{"node":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Monat","type":"Concept","prefLabel":{"de":"Monat"},"altLabel":null,"hiddenLabel":null,"definition":{"de":"In diesem Fall ist der sog. Sonnenmonat gemeint, nach dem im bürgerlichen Leben gerechnet wird. Er dauert 1/12 des Sonnenjahres und zählt 30 Tage, 10 Stunden, 29 Minuten und 4 Sekunden. In der Praxis wird die Monatslänge in 30 bzw. 31 Tage und 28 bzw. 29 Tage im Februar eingeteilt.+Darüber hinaus gibt es noch die auf den Mondumlauf bezogene Monatseinteilung:+1) Synodischer Monat+2) Siderischer Monat+3) Tropischer Monat+4) Anomalistischer Monat."},"note":null,"changeNote":null,"editorialNote":{"de":null},"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[],"narrowerTransitive":[],"broader":null,"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/gefaess/Datum"}],"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"inSchemeAll":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik"}],"topConceptOf":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/"}},"staticQueryHashes":["3649515864","4240049689","63159454"],"slicesMap":{}}