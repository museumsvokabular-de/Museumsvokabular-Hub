{"componentChunkName":"component---src-components-concept-jsx","path":"/grobsystematik/Quarzuhr.html","result":{"pageContext":{"node":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Quarzuhr","type":"Concept","prefLabel":{"de":"Quarzuhr"},"altLabel":{"de":["Uhr (Quarz-)"]},"hiddenLabel":null,"definition":{"de":"Hierbei wird ein Quarz als Schwingungsnormal -_anstatt der Unruh_- eingesetzt; er wird elektrisch über eine elektronische Verstärkung in Schwingung versetzt. Die Schwingungsfrequenz wird derart reduziert, daß diese Methode zur Zeitanzeige mit hervorragenden Gangergebnissen benutzt werden kann.+Die erste Quarzuhr soll 1933/34 von den beiden Physikern Scheibe und Adelsberger gebaut worden sein. 1967 kam die erste Quarzuhr auf den Markt."},"note":null,"changeNote":null,"editorialNote":{"de":null},"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[],"narrowerTransitive":[],"broader":null,"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/gefaess/Armbanduhr,_elektrische"}],"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"inSchemeAll":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik"}],"topConceptOf":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/"}},"staticQueryHashes":["3649515864","4240049689","63159454"],"slicesMap":{}}