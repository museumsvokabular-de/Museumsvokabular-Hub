{"componentChunkName":"component---src-components-concept-jsx","path":"/grobsystematik/Sackuhr.html","result":{"pageContext":{"node":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Sackuhr","type":"Concept","prefLabel":{"de":"Sackuhr"},"altLabel":{"de":["Brater","Uhr (Sack-)","Zwiebel"]},"hiddenLabel":null,"definition":{"de":"Die historische Entwicklung begann mit den ersten tragbaren Uhren die, so nimmt man heute an, teilweise in einem Säckchen aufbewahrt und in der Tasche getragen wurden. Die Sackuhr im eigentlichen Sinn bildete sich aber erst mit der Erfindung der Spiralfeder durch Huygens in der zweiten Hälfte des 17._Jahrhunderts aus, wobei sehr rasch die vielfältigsten Formen, Materialien und Ausführungen in Betracht kamen."},"note":null,"changeNote":null,"editorialNote":{"de":null},"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[],"narrowerTransitive":[],"broader":null,"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/gefaess/Taschenuhr"}],"narrowMatch":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/gefaess/Oignon"}],"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"inSchemeAll":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik"}],"topConceptOf":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/"}},"staticQueryHashes":["3649515864","4240049689","63159454"],"slicesMap":{}}