{"componentChunkName":"component---src-components-concept-jsx","path":"/grobsystematik/Glockenspielwerk.html","result":{"pageContext":{"node":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Glockenspielwerk","type":"Concept","prefLabel":{"de":"Glockenspielwerk"},"altLabel":{"de":["Carillon","Spielwerk (Glocken-)"]},"hiddenLabel":null,"definition":{"de":"Gegossene Halbschalen (die herkömmliche Glockenform war für Uhren nicht zu gebrauchen) wurden auf einer Stange aufgereiht. Die Anzahl der Glocken beschränkte sich meist auf 5 bis 20 Stück. Die auf die Glocken schlagenden Hämmer werden durch eine Stiftwalze betätigt. Solche Glockenspiele kamen hauptsächlich bei Großuhren vor; bei Taschenuhren sind sie nur sehr selten zu finden."},"note":null,"changeNote":null,"editorialNote":{"de":null},"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[],"narrowerTransitive":[],"broader":null,"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/gefaess/Musikwerke"}],"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"inSchemeAll":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik"}],"topConceptOf":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik","title":null}],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/"}},"staticQueryHashes":["3649515864","4240049689","63159454"],"slicesMap":{}}