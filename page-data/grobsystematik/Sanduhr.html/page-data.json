{"componentChunkName":"component---src-components-concept-jsx","path":"/grobsystematik/Sanduhr.html","result":{"pageContext":{"node":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Sanduhr","type":"Concept","prefLabel":{"de":"Sanduhr"},"altLabel":{"de":["Stundenglas","Uhr (Sand-)"]},"hiddenLabel":null,"definition":{"de":"Sie waren unter den elementaren Zeitmessern am bequemsten zu handhaben, weil man keiner mathematischen Voraussetzung bedurfte. Sie sind seit dem 13./14._Jahrhundert bekannt. Man verband zwei Glaskörper so, daß durch eine enge Öffnung eine genau bestimmte Menge Marmor-, Zinn-, oder Bleisand von einem Glas ins andere rinnen konnte. An der, am Glas angebrachten Skala konnte man die Zeit ablesen."},"note":null,"changeNote":null,"editorialNote":{"de":null},"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Glasenuhr","prefLabel":{"de":"Glasenuhr"}},{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Kanzelsanduhr","prefLabel":{"de":"Kanzelsanduhr"}},{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Loguhr","prefLabel":{"de":"Loguhr"}},{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Pulsuhr","prefLabel":{"de":"Pulsuhr"}},{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Reisesanduhr","prefLabel":{"de":"Reisesanduhr"}},{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Taschensanduhr","prefLabel":{"de":"Taschensanduhr"}},{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Viertelstunden-Sanduhr","prefLabel":{"de":"Viertelstunden-Sanduhr"}},{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Eieruhr","prefLabel":{"de":"Eieruhr"}}],"narrowerTransitive":[],"broader":null,"broaderTransitive":null,"related":[],"re