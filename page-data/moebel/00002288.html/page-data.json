{"componentChunkName":"component---src-components-concept-jsx","path":"/moebel/00002288.html","result":{"pageContext":{"node":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/moebel/00002288","type":"Concept","prefLabel":{"de":"Handtuchhalter"},"altLabel":{"de":["Handtuchgestell","Handtuchständer"]},"hiddenLabel":null,"definition":{"de":"Handtuchhalter gibt es in zwei Typen. Der eine, stets hängende, besteht aus Rückwandbrett oder -leiste und darüber angebrachtem Ablagebrett. In die Rückwand sind Haken eingelassen; unter das Ablagebrett ist eine Leiste für das die Gebrauchshandtücher verdeckende Überhandtuch montiert. Der andere Typ - auch Handtuchständer genannt - ist ein stehendes oder hängendes Gestell mit waagerechten Standen, die in unterschiedlicher Höhe angebracht sein können."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/moebel/00000795","prefLabel":{"de":"Gestell"}},"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/moebel","title":null}],"inSchemeAll":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/moebel"}],"topConceptOf":[],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/"}},"staticQueryHashes":["3649515864","4240049689","63159454"],"slicesMap":{}}