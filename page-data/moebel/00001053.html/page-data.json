{"componentChunkName":"component---src-components-concept-jsx","path":"/moebel/00001053.html","result":{"pageContext":{"node":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/moebel/00001053","type":"Concept","prefLabel":{"de":"Sekretär"},"altLabel":{"de":["Schreibkasten","Schreibschrank"]},"hiddenLabel":null,"definition":{"de":"Der Sekretär ist ein Schreibmöbel mit einer klapp- oder herausziehbaren Schreibfläche versehenes Schreibmöbel. Im geschlossenen Zustand ist die Schreibklappe entweder senkrecht oder schräg gestellt. Der Unterbau kann tisch-, schrank- oder kommodenartig sein.Unter den Sekretären finden sich durch ihre Form ausgewiesene Typen wie das Schreibkabinett, der Lyrasekretär oder der Pyramidensekretär."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/moebel/00001054","prefLabel":{"de":"Aufsatzsekretär"}},{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/moebel/00001056","prefLabel":{"de":"Ecksekretär"}},{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/moebel/00002423","prefLabel":{"de":"Klappsekretär"}}],"narrowerTransitive":[],"broader":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/moebel/00001034","prefLabel":{"de":"Schreibmöbel"}},"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/moebel","title":null}],"inSchemeAll":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/moebel"}],"topConceptOf":[],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/"}},"staticQueryHashes":["3649515864","4240049689","63159454"],"slicesMap":{}}