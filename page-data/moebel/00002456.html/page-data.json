{"componentChunkName":"component---src-components-concept-jsx","path":"/moebel/00002456.html","result":{"pageContext":{"node":{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/moebel/00002456","type":"Concept","prefLabel":{"de":"Tütenstuhl"},"altLabel":{"de":["Eistütenstuhl"]},"hiddenLabel":null,"definition":{"de":"Der Tütenstuhl besteht aus einem Kreiskegel aus Metall, dessen Spitze drehbar auf einem Fußkreuz befestigt ist. In Sitzhöhe ist der Kegel einseitig abgeschnitten und mit einem gepolsterten hölzernen Sitzdeckel verschlossen; die darüber fortgeführte Kegelwand ist zur Rückenlehne ausgeformt. Der Stuhlkörper ist mit Stoff überzogen. Der Hohlraum im Kegel ist als Behältnis zu nutzen."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[],"narrowerTransitive":[],"broader":null,"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/gefaess/00001058"}],"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/moebel","title":null}],"inSchemeAll":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/moebel"}],"topConceptOf":[{"id":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/moebel","title":null}],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://museumsvokabular-de.github.io/Museumsvokabular-Hub/"}},"staticQueryHashes":["3649515864","4240049689","63159454"],"slicesMap":{}}