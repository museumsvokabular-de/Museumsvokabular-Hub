<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Rechenschlagwerk> a skos:Concept ;
    dc:identifier "Rechenschlagwerk" ;
    dcq:created "1987-10-07" ;
    skos:altLabel "Schlagwerk (Rechen-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Selbsttätiges_Schlagwerk> ;
    skos:definition "Das Rechenschlagwerk wurde 1676 von Edward Barlow in London erfunden und durch Thomas Tompion und Daniel Quare weiter verbessert.+Die Anzahl der Stundenschläge wird hier nicht durch eine Schloßscheibe, sondern durch die Stundenstaffel, die vom Rechen abgetastet wird, bestimmt. Da die Stundenstaffel mit dem Zeigerwerk verbunden ist, ist Schlagfolge und Stundenangabe immer synchron."@de ;
    skos:editorialNote "A., S. 40f.",
        "B-J/B., S. 210f.",
        "M.I., S. 172ff." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:prefLabel "Rechenschlagwerk"@de .

