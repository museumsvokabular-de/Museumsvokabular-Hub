<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Grahamhemmung> a skos:Concept ;
    dc:identifier "Grahamhemmung" ;
    dcq:created "1987-10-06" ;
    skos:altLabel "Hemmung (Graham-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Ruhende_Hemmungen> ;
    skos:definition "George Graham erfand 1710 diese Hemmung. Im Gegensatz zur Ankerhemmung von Clement änderte er folgendes ab:+1) Die Ruheflächen sind kreisförmig zum Ankerdrehpunkt angeordnet.+2) Die Hebelflächen sind gerade ausgeführt.+3) Das Pendel schwingt nur in einem kurzen Bereich von 6 Grad.+4) Der Anker umfaßt sehr viel mehr Zähne.+Diese Hemmung findet sich hauptsächlich in Präzisionsuhren."@de ;
    skos:editorialNote "A., S. 38f.",
        "B-J/B., S. 177",
        "M.I., S. 118f." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:prefLabel "Grahamhemmung"@de .

