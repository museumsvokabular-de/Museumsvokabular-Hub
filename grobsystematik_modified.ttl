<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Freie_Hemmungen> a skos:Concept ;
    dc:identifier "Freie Hemmungen" ;
    dcq:created "1987-10-06" ;
    skos:altLabel "Hemmungen (Freie)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Hemmungen> ;
    skos:definition "Bei den freien Hemmungen erhält das Schwingsystem_- Pendel, Unruh_- nur in bestimmten, kurzen Zeitintervallen einen Antrieb und kann sonst ohne Beeinträchtigung durch das Räderwerk vollkommen frei schwingen. Auf diese Weise wird der Kontakt Schwingsystem_- Räderwerk auf ein Minimum beschränkt und somit ein weitgehed isochrones Schwingen erreicht."@de ;
    skos:editorialNote "B-J/B., S. 175" ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:narrower <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Ankerhemmung>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Chronometerhemmung>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Federkrafthemmung>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Schwerkrafthemmung> ;
    skos:prefLabel "Freie Hemmungen"@de .

