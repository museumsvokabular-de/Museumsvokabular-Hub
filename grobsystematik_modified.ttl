<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Aufgangsuhr> a skos:Concept ;
    dc:identifier "Aufgangsuhr" ;
    dcq:created "1987-11-05" ;
    skos:altLabel "Schauuhr"@de,
        "Uhr (Aufgangs-)"@de ;
    skos:definition "Es gab Wasseruhren, die außer den Stunden die Himmelsvorgänge anzeigten. Bereits dem um Christi Geburt lebenden römischen Baumeister Vitruv war eine solche Uhr, die er Winteruhr oder Aufgangsuhr nannte, bekannt."@de ;
    skos:editorialNote "Z S.5 ff." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:prefLabel "Aufgangsuhr"@de .

