<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Bilderuhr> a skos:Concept ;
    dc:identifier "Bilderuhr" ;
    dcq:created "1987-10-06" ;
    skos:altLabel "Uhr (Bilder-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Rahmenuhr> ;
    skos:definition "Oft handelt es sich in der bildlichen Darstellung um ländliche Szenen, bei denen meist im Hintergrund ein Turm oder eine Kirche mit kleinem Zifferblatt erkennbar ist. Das Uhrwerk befindet sich auf der Rückseite. Diese Uhren entstanden etwa 1780 und waren vor allem in Süddeutschland, Österreich und der Schweiz zu Hause."@de ;
    skos:editorialNote "B-J/B. S.235 f.",
        "M.II S.182 ff." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:prefLabel "Bilderuhr"@de .

