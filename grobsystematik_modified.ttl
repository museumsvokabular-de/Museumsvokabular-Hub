<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Cartelluhr> a skos:Concept ;
    dc:identifier "Cartelluhr" ;
    dcq:created "1987-06-11" ;
    skos:altLabel "Uhr (Cartell-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Wanduhr> ;
    skos:definition "Eine typisch französische Bauform, bei der das Federzugswerk in ein mehr oder weniger reich ausgebildetes, flach an der Wand liegendes Gehäuse eingesetzt ist. Gehäuse aus Bronzeguß. Die Blütezeit fällt in die Zeit Ludwigs XV. und XVI.+Es gibt Nachahmungen im Wiener Raum, in Stockholm und in der Schweiz. Der Cartellkörper ist bei diesen Uhren aus Holz geschnitzt und mit Blattgold belegt."@de ;
    skos:editorialNote "B-J/B. S.234",
        "M.II S.71 ff." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:narrower <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Oeil_de_Boeuf> ;
    skos:prefLabel "Cartelluhr"@de .

