<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Monstranzuhr> a skos:Concept ;
    dc:identifier "Monstranzuhr" ;
    dcq:created "1987-10-09" ;
    skos:altLabel "Uhr (Monstranz-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Spiegeluhr> ;
    skos:definition "Uhrtyp des 17._Jahrhunderts bei dem das Uhrwerk in eine monstranzförmige Tischuhr eingebaut wurde. Diese Uhren haben einen religiös-sinnbildlichen Charakter und sind stets kostbar ausgeführt."@de ;
    skos:editorialNote "B-J/B. S.244",
        "M.II, S.36" ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:prefLabel "Monstranzuhr"@de .

<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Montre_a_toc> a skos:Concept ;
    dc:identifier "Montre a toc" ;
    dcq:created "1987-10-08" ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Blindentaschenuhr> ;
    skos:definition "Eine Taschenuhr mit Schlagwerk, die aber kein akustisches Geräusch abgab, sondern mittels eines Hebelchens geräuschlos, aber fühlbar, die Zeit klopfte. Diese Art Schlagwerk wurde von Julien Le Roy erfunden."@de ;
    skos:editorialNote "L., S. 288",
        "M.I., S. 222" ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:prefLabel "Montre a toc"@de .

