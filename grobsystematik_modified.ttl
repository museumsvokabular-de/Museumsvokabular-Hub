        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Quadratische_Tischuhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Rechteckige_Tischuhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Reiseuhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Runde_Tischuhr> ;
    skos:prefLabel "Tischuhr"@de .

