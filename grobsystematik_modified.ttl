<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Hakenhemmung> a skos:Concept ;
    dc:identifier "Hakenhemmung" ;
    dcq:created "1987-10-06" ;
    skos:altLabel "Clementgang"@de,
        "Hemmung (Haken-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Rückführende_Hemmung> ;
    skos:definition "Diese Hemmung wurde um 1680 von William Clement erfunden. Es handelt sich um eine rückführende Ankerhemmung in Verbindung mit einem Pendel. Wie man aus dem Bewegungsablauf in der Funktionsskizze ersehen kann, wird das Hemmrad beim Ergänzungsbogen des Pendels zurückgedrückt.+Noch heute findet man diese, auch Clement-Ankergang genannte Hemmung, in einfacher Abwandlung als sogenannten Schwarzwälder Hakengang bei einfachen Schwarzwalduhren."@de ;
    skos:editorialNote "A., S. 38",
        "B-J/B., S. 176",
        "M.I., S. 113 f." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:prefLabel "Hakenhemmung"@de .

