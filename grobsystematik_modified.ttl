<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Äquation> a skos:Concept ;
    dc:identifier "Äquation" ;
    dcq:created "1987-10-06" ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Astronomische_Indikationen> ;
    skos:definition "Äquation (Zeitgleichung) ist die Differenz zwischen der mittleren und der wahren Sonnenzeit eines Ortes. Die \"mittlere\" Zeit, das ist diejenige nach der sich das bürgerliche Leben richtet, weicht von der wahren Sonnenzeit im Laufe des Jahres zwischen plus 16_Minuten und minus 14_Minuten ab. Am 16._April , 14._Juni, 1._September und 25._Dezember fallen wahre und mittlere Zeit zusammen.+Die Erfindung des Äquationswerkes wurde am Ende des 17._Jahrhunderts gemacht."@de ;
    skos:editorialNote "A., S. 105ff.",
        "B-J/B., S. 23",
        "L., S. 398",
        "M.I., S. 212" ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:prefLabel "Äquation"@de .

<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Äquatorium> a skos:Concept ;
    dc:identifier "Äquatorium" ;
    dcq:created "1987-06-11" ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Astrolabium> ;
    skos:definition "Ein spätmittelalterliches, außerordentlich seltenes Gerät, um die Planetenstellung in Bezug auf die Erde zu ermitteln."@de ;
    skos:editorialNote "B-J/B. S.141" ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:prefLabel "Äquatorium"@de .

