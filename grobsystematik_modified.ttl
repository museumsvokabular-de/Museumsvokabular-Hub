<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Zylinderhemmung> a skos:Concept ;
    dc:identifier "Zylinderhemmung" ;
    dcq:created "1987-10-08" ;
    skos:altLabel "Hemmung (Zylinder-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Ruhende_Hemmungen> ;
    skos:definition "Die Zylinderhemmung wurde 1695 von Thomas Tompion erfunden und von seinem Schüler George Graham um 1720 verbessert. Der Name der Hemmung kommt von der teils hohlen, zylindrischen Form der Unruhewelle. Charakteristisch für diese Hemmung sind die auf kleinen Hälsen sitzenden dreiecksförmigen Hemmradzähne.+Von der Mitte des 19. bis zu Beginn des 20._Jahrhunderts war sie eine der verbreitesten Hemmungen."@de ;
    skos:editorialNote "A., S. 238",
        "B-J/B., S. 178",
        "L., S. 352f.",
        "M.I., S. 145ff." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:prefLabel "Zylinderhemmung"@de .

