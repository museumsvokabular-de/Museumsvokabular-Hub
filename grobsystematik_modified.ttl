<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Dosenuhr> a skos:Concept ;
    dc:identifier "Dosenuhr" ;
    dcq:created "1987-10-06" ;
    skos:altLabel "Uhr (Dosen-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Anhängeruhr> ;
    skos:definition "Die Dosenuhr ist der Urtyp der tragbaren Uhr. Man unterscheidet die zylindrische und die wulstförmige Dosenuhr. Sie entstand zu Anfang des 16._Jahrhunderts und konnte sowohl an einer Kette um den Hals getragen werden, wie auch in einem Beutel in der Tasche."@de ;
    skos:editorialNote "L., S. 285",
        "M.II., S. 37ff." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:narrower <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Nürnberger_Ei>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Wulstförmige_Dosenuhr>,
