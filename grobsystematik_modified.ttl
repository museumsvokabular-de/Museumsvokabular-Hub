<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Wanduhr> a skos:Concept ;
    dc:identifier "Wanduhr" ;
    dcq:created "1987-10-08" ;
    skos:altLabel "Uhr (Wand-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Großuhren>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Uhr> ;
    skos:definition "Unter Wanduhren wollen wir alle direkt an der Wand befestigten Uhren, einschließlich Uhren auf Konsolen verstehen. Hier ist eine gewisse Überschneidung mit Stutzuhren unvermeidlich, da diese schon zu ihrer Zeit nicht nur auf Möbeln, sondern auch auf Konsolen aufgestellt wurden."@de ;
    skos:editorialNote "B-J/B. S.229" ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
