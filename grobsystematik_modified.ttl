<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Telleruhr> a skos:Concept ;
    dc:identifier "Telleruhr" ;
    dcq:created "1987-10-08" ;
    skos:altLabel "Uhr (Teller-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Wanduhr> ;
    skos:definition "Eine spezifisch deutsche, wohl in Augsburg oder Nürnberg am Ende des 16. Jahrhunderts entstandene Form der Wanduhr. Das Zifferblatt ist wie ein Prunkteller mit breitem Rand versehen, der einen Ring trägt, welcher zum Aufhängen der Uhr an einem Wandarm dient. Telleruhren sind fast immer Federzuguhren. Zuerst haben die Telleruhren eine innen liegende Unrast, später fast immer ein kurzes Pendel vor dem Blatt."@de ;
    skos:editorialNote "B-J/B. S.233",
        "M.II S.85 ff." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:prefLabel "Telleruhr"@de .

