<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Lantern_Clock> a skos:Concept ;
    dc:identifier "Lantern Clock" ;
    dcq:created "1987-10-08" ;
    skos:altLabel "Clock (Lantern)"@de,
        "Laternenuhr"@de,
        "Laternuhr"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Wanduhr> ;
    skos:definition "In Anlehnung an die süddeutschen gotischen Wanduhren in Prismenbauweise entwickelte sich im 17. und vor allem im 18._Jahrhundert in England die sogenannte Laternenuhr. Der gedrungene Glockenstuhl über dem Werk wird von meist drei mehr oder weniger gravierten, aber stets durchbrochenen 'Frets' (Verzierungen) abgedeckt. Diese englische Uhrenform wird auch auf dem Kontinent übernommen."@de ;
    skos:editorialNote "M.II S.100 ff." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:narrower <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Wing_Lantern_Clock> ;
    skos:prefLabel "Lantern Clock"@de .

