<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Stockuhr> a skos:Concept ;
    dc:identifier "Stockuhr" ;
    dcq:created "1987-08-24" ;
    skos:altLabel "Uhr (Stock-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Stutzuhr> ;
    skos:definition "Das Uhrwerk ist in einem prismatischen Holzkästchen mit einer in der Form den jeweiligen Moderichtungen folgenden Bekrönung oder Dach anfänglich häufig mit einer Figur, später meist mit einem charakteristischen Henkel, eingeschlossen. Auf der Vorderseite befindet sich ein großes Zifferblatt, anfänglich frei, später hinter einer verglasten Tür. Auch die Kastenseiten sind häufig verglast, gelegentlich aber durch Gitterwerk verschlossen. Im 18. Jahrhundert eine der verbreitetsten Formen in Mitteleuropa. Gegenstück zur französischen Pendule."@de ;
    skos:editorialNote "B-J/B. S.245 ff.",
        "M.II S.105 ff." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:narrower <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Altaruhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Englische_Stockuhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Kontinentaleuropäische_Stockuhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Nachtlichtuhr> ;
    skos:prefLabel "Stockuhr"@de .

<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Stooluhr> a skos:Concept ;
