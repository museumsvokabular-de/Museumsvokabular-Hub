<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Sanduhr> a skos:Concept ;
    dc:identifier "Sanduhr" ;
    dcq:created "1987-10-08" ;
    skos:altLabel "Stundenglas"@de,
        "Uhr (Sand-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Elementaruhren>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Uhr> ;
    skos:definition "Sie waren unter den elementaren Zeitmessern am bequemsten zu handhaben, weil man keiner mathematischen Voraussetzung bedurfte. Sie sind seit dem 13./14._Jahrhundert bekannt. Man verband zwei Glaskörper so, daß durch eine enge Öffnung eine genau bestimmte Menge Marmor-, Zinn-, oder Bleisand von einem Glas ins andere rinnen konnte. An der, am Glas angebrachten Skala konnte man die Zeit ablesen."@de ;
    skos:editorialNote "B-J/B. S.338 ff.",
        "L. S.85 ff.",
        "M.I S.77 ff." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:narrower <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Eieruhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Glasenuhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Kanzelsanduhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Loguhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Pulsuhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Reisesanduhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Taschensanduhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Viertelstunden-Sanduhr> ;
    skos:prefLabel "Sanduhr"@de .

