<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Schiebkarren_-_Schubkarren_(Landwirtschaft)> a skos:Concept ;
    dc:identifier "Schiebkarren - Schubkarren (Landwirtschaft)" ;
