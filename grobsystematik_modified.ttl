<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Rahmenuhr> a skos:Concept ;
    dc:identifier "Rahmenuhr" ;
    dcq:created "1987-10-08" ;
    skos:altLabel "Uhr (Rahmen-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Wanduhr> ;
    skos:definition "Als Rahmenuhr bezeichnet man eine Uhrengattung, die fast nur in Wien hergestellt wurde. Es handelt sich meist um vergoldete Holzrahmen mit Ochsenaugenornamentik der Biedermeierzeit, die statt eines Bildes eine mehr oder weniger verzierte Holzplatte, oder eine geprägte oder vergoldete Messingfront tragen, in die ein Zifferblatt eingearbeitet ist."@de ;
    skos:editorialNote "B-J/B. S.235 f.",
        "M.II S.182 ff." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:narrower <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Bilderuhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Schwarzwälder_Rahmenuhr> ;
    skos:prefLabel "Rahmenuhr"@de .

