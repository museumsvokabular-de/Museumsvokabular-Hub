    dc:identifier "Schwerkrafthemmung" ;
    dcq:created "1987-09-07" ;
    skos:altLabel "Hemmung (Schwerkraft-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Freie_Hemmungen> ;
    skos:definition "Es handelt sich bei der Schwerkrafthemmung um eine freie in Präzisionsuhren eingebaute Hemmung. Das Pendel wird hier nicht wie sonst üblich durch eine Gabel angetrieben, sondern durch Gewichte, die zu genau definierten Zeiten auf das Pendel wirken und so einen Impuls erteilen; die übrige Zeit schwingt das Pendel frei."@de ;
    skos:editorialNote "M.I., S. 121ff." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:prefLabel "Schwerkrafthemmung"@de .

