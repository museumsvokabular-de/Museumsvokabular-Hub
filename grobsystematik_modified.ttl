<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Reiseuhr> a skos:Concept ;
    dc:identifier "Reiseuhr" ;
    dcq:created "1987-11-19" ;
    skos:altLabel "Uhr (Reise-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Tischuhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Uhr> ;
    skos:definition "Dieser Uhrtyp wurde zuerst in Frankreich und später auch in Neuenburg hergestellt. Die frühen Uhren hatten immer kleine Bronzegehäuse, die in leder- oder samtausgeschlagenen Holzgehäusen auf Reisen mitgeführt werden konnten.+Sie sind schon im 18._Jahrhundert bekannt und besitzen immer hochwertige Schlagwerke und ein zusätzliches Weckerwerk."@de ;
    skos:editorialNote "B-J/B. S.304",
        "M.II S.187 ff." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:narrower <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Capucine>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Kutschenuhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Wecker> ;
    skos:prefLabel "Reiseuhr"@de .

