<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Appenzeller_Uhr> a skos:Concept ;
    dc:identifier "Appenzeller Uhr" ;
    dcq:created "1987-10-06" ;
    skos:altLabel "Uhr (Appenzeller)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Schweizer_Uhr> ;
    skos:definition "Aus dem Kanton Appenzell stammen die schönsten und zahlreichsten heute noch erhaltenen Schweizer Bauernuhren. Die Appenzeller Uhren zeichnen sich durch vielgestaltige Zifferblatt- und Gehäuseformen aus und sind des öfteren signiert. Häufig trifft man bei diesen Uhren Stundenschlag, Vier-Viertel-Schlag oder Weckereinrichtung an."@de ;
    skos:editorialNote "A., S.71f." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:prefLabel "Appenzeller Uhr"@de .

