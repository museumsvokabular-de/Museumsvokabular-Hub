<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Kommahemmung> a skos:Concept ;
    dc:identifier "Kommahemmung" ;
    dcq:created "1987-11-05" ;
    skos:altLabel "Hemmung (Komma-)"@de,
        "Virgulehemmung"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Ruhende_Hemmungen> ;
    skos:definition "Die Kommahemmung wurde um 1765 wahrscheinlich von Jean Antoine Lepine erfunden und leitet ihren Namen von dem kommaförmigen Impulshebel an der Unruhwelle ab. Die Hemmung ähnelt in einigen Teilen der Zylinder- und in anderen der Duplexhemmung. Charakteristisch ist das flache Hemmrad, das an den Zahnspitzen aufrechtstehende Zähne (Stifte) besitzt."@de ;
    skos:editorialNote "A., S. 239",
        "M.I., S. 142ff." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:prefLabel "Kommahemmung"@de .

