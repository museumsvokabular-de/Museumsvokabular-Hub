    skos:definition "Eine Sonnenuhr ist mit einem zweiten System kombiniert, das zum Ablesen der Zeit bei Mondlicht dient, wozu die Kenntnis des Mondalters nötig ist."@de ;
    skos:editorialNote "Z S.166 f." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:prefLabel "Monduhr"@de .

