<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Äquatorialsonnenuhr> a skos:Concept ;
    dc:identifier "Äquatorialsonnenuhr" ;
    dcq:created "1987-10-06" ;
    skos:altLabel "Sonnenuhr (Äquatorial-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Sonnenuhr> ;
    skos:definition "Der im 17. und 18. Jahrhundert dominierende Sonnenuhrtyp. Zifferblatt rechtwinklig zum Polos angeordnet. Die Indikationsskala liegt also parallel zur Ebene des Äquators. Da diese Sonnenuhren meist zusammengeklappt aufbewahrt wurden, mußte zum Gebrauch die Skala erst in jenem Winkel zur Horizontebene eingestellt werden, der der geographischen Breite, Polhöhe des Beobachters entsprach."@de ;
    skos:editorialNote "B-J/B. S.108 f." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:narrower <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Tischsonnenuhr,_äquatorial>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Äquinoktialring> ;
    skos:prefLabel "Äquatorialsonnenuhr"@de .

