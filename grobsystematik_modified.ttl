    skos:prefLabel "Mondsichelmadonna-Statuette"@de .

<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Monduhr> a skos:Concept ;
    dc:identifier "Monduhr" ;
    dcq:created "1987-08-20" ;
    skos:altLabel "Tag- und Nachtuhr"@de,
        "Uhr (Mond-)"@de ;
