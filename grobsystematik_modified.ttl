<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Azimutalsonnenuhr> a skos:Concept ;
    dc:identifier "Azimutalsonnenuhr" ;
    dcq:created "1987-10-06" ;
    skos:altLabel "Sonnenuhr (Azimutal-)"@de ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Sonnenuhr> ;
    skos:definition "Dieser Typus ist stets für eine bestimmte geographische Breite gearbeitet und daher nur in einem begrenzten Gebiet brauchbar. Derartige Sonnenuhren waren schon in der ersten Hälfte des 15. Jahrhunderts bekannt."@de ;
    skos:editorialNote "B-J/B. S.109 f." ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:narrower <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Analemmatische_Sonnenuhr>,
