<https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Zappler> a skos:Concept ;
    dc:identifier "Zappler" ;
    dcq:created "1987-08-13" ;
    skos:broader <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Stutzuhr>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Uhr> ;
    skos:definition "Sie sind im Aufbau ähnlich den Telleruhren, haben aber gewöhnlich zwei fußartige Ansätze am Zifferblatt und eine Stütze am Werk zur Aufstellung auf Kommoden, Regalen usw. Der Name kommt von der lebhaften Bewegung des kurzen Pendels vor dem Zifferblatt. Die Zappler des 18. Jahrhunderts stammen vorwiegend aus Augsburg, München, Graz und Wien."@de ;
    skos:editorialNote "B-J/B. S.257" ;
    skos:inScheme <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik> ;
    skos:narrower <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Barockzappler>,
        <https://museumsvokabular-de.github.io/Museumsvokabular-Hub/grobsystematik/Scherenzappler>,
